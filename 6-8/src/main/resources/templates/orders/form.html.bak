<form th:action="${orderForm.orderId == null}
        ? @{/orders}
        : @{/orders/{id}/update(id=${orderForm.orderId})}"
      th:object="${orderForm}"
      method="post"<!DOCTYPE html>

<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>受注登録</title>
</head>
<body>

<h1>受注登録</h1>

<form th:action="@{/orders}" th:object="${orderForm}" method="post">

```
<div>
    <label>受注番号</label>
    <input type="text" th:field="*{orderNo}">
    <div th:if="${#fields.hasErrors('orderNo')}"
         th:errors="*{orderNo}"></div>
</div>

<div>
    <label>購入者名</label>
    <input type="text" th:field="*{customerName}">
    <div th:if="${#fields.hasErrors('customerName')}"
         th:errors="*{customerName}"></div>
</div>

<div>
    <label>商品</label>
    <select th:field="*{productId}">
        <option value="">選択してください</option>

        <option th:each="product : ${products}"
                th:value="${product.productId}"
                th:text="${product.productName}">
        </option>
    </select>
    <div th:if="${#fields.hasErrors('productId')}"
         th:errors="*{productId}"></div>
</div>

<div>
    <label>数量</label>
    <input type="number"
           th:field="*{quantity}"
           min="1"
           max="999">
    <div th:if="${#fields.hasErrors('quantity')}"
         th:errors="*{quantity}"></div>
</div>

<div>
    <label>ステータス</label>
    <select th:field="*{orderStatus}">
        <option value="">選択してください</option>
        <option value="受付">受付</option>
        <option value="処理中">処理中</option>
        <option value="発送済み">発送済み</option>
        <option value="完了">完了</option>
    </select>
    <div th:if="${#fields.hasErrors('orderStatus')}"
         th:errors="*{orderStatus}"></div>
</div>

<div>
    <label>受注日</label>
    <input type="date" th:field="*{orderDate}">
    <div th:if="${#fields.hasErrors('orderDate')}"
         th:errors="*{orderDate}"></div>
</div>

<div>
    <label>希望納期</label>
    <input type="date" th:field="*{deliveryDate}">
</div>

<div th:if="${errorMessage}">
    <p th:text="${errorMessage}"></p>
</div>

<button type="submit">登録</button>

<a th:href="@{/orders}">戻る</a>
```

</form>

</body>
</html>
